---
import BaseLayout from '../layouts/BaseLayout.astro';
import { externalLinks } from '../data/links';

const explorationCards = [
  {
    title: 'Deterministic evidence first',
    body: 'The core facts come from repeatable checks, profiles, comparisons, validations, and trace files.'
  },
  {
    title: 'Bounded LLM support',
    body: 'LLMs are used only where they help with wording, suggestions, or review notes from safe context.'
  },
  {
    title: 'Review-ready artifacts',
    body: 'Each agent writes outputs a person can inspect: reports, traces, findings, summaries, exceptions, or review packs.'
  },
  {
    title: 'Human judgement stays outside the tool',
    body: 'The agents prepare evidence and questions. They do not approve, certify, or replace review.'
  }
];

const suitePhases = [
  {
    label: 'Phase 1',
    title: 'Data foundations',
    agents: [
      {
        number: 1,
        title: 'Data Quality Triage Agent',
        helps: 'Helps with the first pass of understanding what looks wrong in a dataset.',
        demonstrates: 'deterministic data quality checks with optional LLM-polished reporting.',
        href: externalLinks.dqtAgent
      },
      {
        number: 2,
        title: 'Data Reconciliation Agent',
        helps: 'Checks whether source-to-target movement preserved the important records and mapped values.',
        demonstrates: 'mapping-driven comparison, exception outputs, and traceable reconciliation.',
        href: externalLinks.reconciliationAgent
      },
      {
        number: 3,
        title: 'Data Dictionary Agent',
        helps: 'Creates first-pass data dictionaries from local CSV and XLSX datasets.',
        demonstrates: 'deterministic profiling as the evidence base, with optional LLM wording support.',
        href: externalLinks.dictionaryAgent
      }
    ]
  },
  {
    label: 'Phase 2',
    title: 'Rules, risk, and test design',
    agents: [
      {
        number: 4,
        title: 'Data Contract Review Agent',
        helps: 'Checks whether a dataset matches agreed contract rules.',
        demonstrates: 'repeatable validation against required columns, types, nulls, allowed values, and other rules.',
        href: externalLinks.contractReviewAgent
      },
      {
        number: 5,
        title: 'Sensitive Field Review Agent',
        helps: 'Flags fields that may need careful human review before data is shared, migrated, analysed, or used downstream.',
        demonstrates: 'policy-led sensitive-field indicators without legal or compliance verdicts.',
        href: externalLinks.sensitiveFieldReviewAgent
      },
      {
        number: 6,
        title: 'Data Test Suggestion Agent',
        helps: 'Suggests reviewable data tests from profiling evidence and supplied context.',
        demonstrates: 'LLM-assisted test design with deterministic validation of candidates.',
        href: externalLinks.testSuggestionAgent
      }
    ]
  },
  {
    label: 'Phase 3',
    title: 'Review workflows',
    agents: [
      {
        number: 7,
        title: 'Dataset Onboarding Reviewer Workflow',
        helps: 'Prepares an early review pack for a new dataset before people start relying on it.',
        demonstrates: 'a workflow-shaped agent that moves from profile to context gaps, questions, answers, and report.',
        href: externalLinks.onboardingReviewerWorkflow
      },
      {
        number: 8,
        title: 'Data Quality Investigation Workflow',
        helps: 'Helps investigate a stated data quality concern using current and optional baseline files.',
        demonstrates: 'evidence-led investigation notes without claiming root cause.',
        href: externalLinks.qualityInvestigationWorkflow
      },
      {
        number: 9,
        title: 'Project Evidence Review Agent',
        helps: 'Reviews scattered project evidence and highlights what is supported, missing, unclear, or in tension.',
        demonstrates: 'evidence-pack construction, citation-style review, optional LLM notes, and safe validation.',
        href: externalLinks.projectEvidenceReviewAgent
      }
    ]
  },
  {
    label: 'Phase 4',
    title: 'Migration review',
    agents: [
      {
        number: 10,
        title: 'Data Migration Readiness Review Agent',
        helps: 'Reviews a migration pack for visible evidence, gaps, mappings, contracts, reconciliation checks, sensitive-field indicators, and test coverage.',
        demonstrates: 'a fuller review workflow with manifest intake, deterministic artifacts, optional LLM notes, optional LangGraph orchestration, and trace metadata.',
        href: externalLinks.migrationReadinessReviewAgent
      }
    ]
  }
];

const patternItems = [
  'Start with a practical data workflow.',
  'Read local files or supplied evidence.',
  'Run deterministic checks first.',
  'Write traceable artifacts.',
  'Add optional LLM support only after the evidence exists.',
  'Keep human review and final judgement outside the tool.'
];
---
<BaseLayout
  title="Data Agent Suite"
  description="A completed 10-agent suite for practical local-first data workflows, deterministic evidence, bounded LLM support, and review-ready artifacts."
>
  <div class="page agents-page">
    <section class="site-shell hero" aria-labelledby="agents-title">
      <span class="hero__rule" aria-hidden="true"></span>
      <h1 id="agents-title">Data Agent Suite</h1>
      <p class="hero__lead">A suite of 10 local-first data agents built around practical data workflows, deterministic evidence, bounded LLM use, and review-ready artifacts.</p>
      <div class="hero__copy">
        <p>The Data Agent Suite explores a practical question: where do deterministic checks, review workflows, and LLM support each belong?</p>
        <p>The agents start with simple local tools that inspect files and produce traceable outputs. They then build toward richer review workflows where LLMs can help with explanation or suggestions, but not replace the evidence.</p>
      </div>
    </section>

    <section class="site-shell section" aria-labelledby="exploring-title">
      <div class="section-heading">
        <h2 id="exploring-title">What this suite is exploring</h2>
      </div>
      <div class="card-grid">
        {explorationCards.map((card) => (
          <article class="simple-card simple-card--soft simple-card--marked">
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section section--panel" aria-labelledby="journey-title">
      <div class="section-heading">
        <h2 id="journey-title">The journey through the 10 agents</h2>
      </div>
      <p class="section-note">The suite moves from first-pass local checks to fuller review workflows, keeping evidence and judgement separate throughout.</p>
      <div class="content-panel content-panel--solid suite-journey">
        {suitePhases.map((phase) => (
          <section class="suite-phase" aria-label={`${phase.label}: ${phase.title}`}>
            <div class="suite-phase__heading">
              <p class="suite-phase__label">{phase.label}</p>
              <h3>{phase.title}</h3>
            </div>
            <ol class="agent-spine" start={phase.agents[0].number}>
              {phase.agents.map((agent) => (
                <li class="agent-spine__item">
                  <span class="timeline-number agent-spine__number" aria-hidden="true">{agent.number}</span>
                  <div class="agent-spine__body">
                    <div class="agent-spine__header">
                      <h4>{agent.title}</h4>
                      <a class="agent-spine__link text-link" href={agent.href} target="_blank" rel="noreferrer">GitHub repo</a>
                    </div>
                    <p>{agent.helps}</p>
                    <p class="agent-spine__meta"><span>Demonstrates:</span> {agent.demonstrates}</p>
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    </section>

    <section class="site-shell section" aria-labelledby="pattern-title">
      <div class="section-heading">
        <h2 id="pattern-title">Common pattern across the suite</h2>
      </div>
      <div class="content-panel pattern-panel">
        <p>Across the suite, the pattern stays deliberately consistent:</p>
        <ol class="pattern-list">
          {patternItems.map((item) => <li>{item}</li>)}
        </ol>
      </div>
    </section>

    <section class="site-shell section" aria-labelledby="changed-title">
      <div class="section-heading">
        <h2 id="changed-title">What changed from agent 1 to agent 10</h2>
      </div>
      <div class="prose">
        <p>The early agents focus on one clear job: profile, reconcile, document, or validate.</p>
        <p>The later agents become more workflow-shaped. They prepare review packs, manage evidence gaps, structure follow-up questions, and separate deterministic findings from optional LLM notes.</p>
        <p>By the final agent, the suite has a fuller pattern: manifest intake, deterministic review stages, aggregated findings, Markdown summaries, optional LLM notes, orchestration seams, and trace metadata.</p>
      </div>
    </section>

    <section class="site-shell section" aria-labelledby="future-title">
      <div class="closing-section">
        <div class="section-heading">
          <h2 id="future-title">Where this could go</h2>
        </div>
        <div class="prose">
          <p>The next step would not simply be more agents.</p>
          <p>The more interesting direction is coordination: a router or workbench layer that can decide which specialist agent fits a given task, pass the right files and context, and keep outputs traceable across workflows.</p>
          <p>Before that, each specialist agent needs to remain useful on its own.</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
